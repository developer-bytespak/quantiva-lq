# Supabase (for contact form submissions – table "Leads" with id, name, email)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use service role key so inserts bypass RLS (keep secret, server-only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Or use anon key (requires RLS policy allowing INSERT on Leads)
# SUPABASE_ANON_KEY=your-anon-key

# Optional: if your table name is not "Leads"
# SUPABASE_CONTACTS_TABLE=your_table_name

# Optional: Redis fallback when Supabase is not configured
# REDIS_URL=redis://...
